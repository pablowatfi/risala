# ─── LLM ─────────────────────────────────────────────────────────────────────
# Provider: ollama | groq | openai
LLM_PROVIDER=ollama
LLM_SMART_MODEL=llama3.3
LLM_FAST_MODEL=llama3.2

# Ollama (used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Groq (used when LLM_PROVIDER=groq)
GROQ_API_KEY=

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://messageos:messageos@postgres:5432/messageos
DATABASE_URL_SYNC=postgresql://messageos:messageos@postgres:5432/messageos
REDIS_URL=redis://redis:6379

# ─── Telegram ─────────────────────────────────────────────────────────────────
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your personal chat ID — send /start to your bot, then check /getme or use @userinfobot
TELEGRAM_CHAT_ID=

# ─── Gmail OAuth ──────────────────────────────────────────────────────────────
# Path to downloaded credentials.json from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials/gmail_credentials.json
# Token files are created automatically on first OAuth flow
GMAIL_WORK_TOKEN_FILE=credentials/gmail_work_token.json
GMAIL_PERSONAL_TOKEN_FILE=credentials/gmail_personal_token.json
# Gmail account addresses
GMAIL_WORK_ADDRESS=you@work.com
GMAIL_PERSONAL_ADDRESS=you@personal.com

# Polling schedule — HH:MM comma-separated, system local timezone
POLL_TIMES=08:00,12:30,19:00
# File to persist last-seen historyId per account
GMAIL_POLL_STATE_FILE=.gmail_poll_state.json

# ─── CV documents ────────────────────────────────────────────────────────────
CV_PDF_DIR=./cv_docs/pdf
CV_JOBS_DIR=./cv_docs/jobs

# ─── Search ───────────────────────────────────────────────────────────────────
TAVILY_API_KEY=tvly-...

# ─── Langfuse observability (optional) ───────────────────────────────────────
# Get keys at cloud.langfuse.com → Project Settings → API Keys
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com   # or your self-hosted URL

# ─── Webhook ──────────────────────────────────────────────────────────────────
# Public URL from ngrok — run: ngrok http 8000
WEBHOOK_BASE_URL=https://YOUR_NGROK_URL.ngrok-free.app
